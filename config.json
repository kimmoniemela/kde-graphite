      "WallpaperPlugin": "org.kde.color"
    },
    "Greeter][LnF][General": {
      "alwaysShowClock": "true",
      "hideClockWhenIdle": "false",
      "showMediaControls": "false"
    },
    "Greeter][Wallpaper][org.kde.color][General": {
      "Color": "#111416"
    }
  },
  "kded5rc": {
    "Module-gtkconfig": {
      "autoload": "false"
    }
  }
