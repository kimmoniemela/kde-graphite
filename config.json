{
  "kwinrc": {
    "Windows": {
      "BorderlessMaximizedWindows": "false",
      "PerOutputVirtualDesktops": "true"
    },
    "org.kde.kdecoration2": {
      "library": "org.kde.breeze",
      "theme": "Breeze",
      "BorderSize": "Tiny",
      "BorderSizeAuto": "false",
      "ButtonsOnLeft": "",
      "ButtonsOnRight": "IAX"
    },
    "Plugins": {
      "blurEnabled": "false",
      "contrastEnabled": "false",
      "fadeEnabled": "false",
      "fadedesktopEnabled": "false",
      "fadingpopupsEnabled": "false",
      "fullscreenEnabled": "false",
      "magicLampEnabled": "false",
      "maximizeEnabled": "false",
      "scaleEnabled": "false",
      "slideEnabled": "false",
      "slidingnotificationsEnabled": "false",
      "slidingpopupsEnabled": "false",
      "squashEnabled": "false",
      "windowapertureEnabled": "false",
      "wobblywindowsEnabled": "false",
      "kde-hypr-bridgeEnabled": "true",
      "kde-hypr-launchers-v2Enabled": "true",
      "kde-hypr-launchersEnabled": "false",
      "kwin_hypr_scroll_desktopEnabled": "true"
    }
  },
  "breezerc": {
    "Common": {
      "ButtonSize": "ButtonSmall",
